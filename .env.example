# Port on the host to publish Coder's web UI on.
HOST_PORT=80

# GID of the "docker" group on the host, so the coder container can
# write to the mounted docker.sock. Find it with: getent group docker
DOCKER_GROUP_ID=999

# --- Postgres ---
POSTGRES_USER=coder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coder

# --- Coder ---
CODER_REPO=ghcr.io/coder/coder
# Pin to a specific version and bump deliberately. Check for new
# releases at https://github.com/coder/coder/releases
CODER_VERSION=2.36.5

# Reachable over Tailscale - use this host's tailnet IP or MagicDNS
# name, e.g. http://coder-vm:80 (no TLS needed; Tailscale handles
# transport encryption). Cannot be localhost/127.0.0.1.
CODER_ACCESS_URL=http://100.x.x.x:80
CODER_EXTERNAL_AUTH_0_ID=github
CODER_EXTERNAL_AUTH_0_TYPE=github
CODER_EXTERNAL_AUTH_0_CLIENT_ID=change-me
CODER_EXTERNAL_AUTH_0_CLIENT_SECRET=change-me
CODER_EXTERNAL_AUTH_0_DISPLAY_NAME=GitHub
